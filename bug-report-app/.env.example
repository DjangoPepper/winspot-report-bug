# Créez un fichier .env en copiant ce fichier et remplacez les valeurs

# Token d'accès GitHub (https://github.com/settings/tokens)
# Permissions nécessaires : repo (accès complet au repo)
VITE_GITHUB_TOKEN=ghp_xxxxxxxxxxxxx

# Repository GitHub (format: username/repo)
VITE_GITHUB_REPO=DjangoPepper/winspot-report-bug
