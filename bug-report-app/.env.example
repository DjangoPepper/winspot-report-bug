# Créez un fichier .env en copiant ce fichier et remplacez les valeurs.

# Endpoint de l'API (AWS API Gateway -> Lambda -> S3)
VITE_API_URL=https://xxxxxxxxxx.execute-api.eu-west-3.amazonaws.com

# Secret partagé envoyé dans l'en-tête x-app-secret (doit correspondre à
# la variable APP_SECRET de la Lambda winspot-bugs-api).
VITE_API_SECRET=remplacez_par_le_secret
