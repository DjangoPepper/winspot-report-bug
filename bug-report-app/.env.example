# Créez un fichier .env en copiant ce fichier et remplacez les valeurs

# Token d'accès GitHub (https://github.com/settings/tokens)
# Permissions nécessaires : repo (accès complet au repo)
VITE_GITHUB_TOKEN=ghp_xxxxxxxxxxxxx

# Repository GitHub (format: username/repo)
VITE_GITHUB_REPO=DjangoPepper/winspot-report-bug

# Firebase Configuration (https://firebase.google.com)
VITE_FIREBASE_API_KEY=AIzaSyxxxxxxxxxxxxxxxxxxxxxxxxx
VITE_FIREBASE_AUTH_DOMAIN=your-project.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=your-project-id
VITE_FIREBASE_STORAGE_BUCKET=your-project.appspot.com
VITE_FIREBASE_MESSAGING_SENDER_ID=123456789
VITE_FIREBASE_APP_ID=1:123456789:web:abcdef123456
