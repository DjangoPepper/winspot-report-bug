{
  "name": "winspot-report-bug",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "homepage": "https://stepe.click/bugs/",
  "scripts": {
    "dev": "vite",
    "build": "tsc && vite build",
    "preview": "vite preview",
    "deploy": "npm run build && npm run deploy:s3",
    "deploy:gh": "npm run build && gh-pages -d dist",
    "deploy:s3": "aws s3 sync dist s3://steppe/bugs --delete --cache-control 'max-age=3600'"
  },
  "dependencies": {
    "firebase": "^12.14.0",
    "react": "^18.2.0",
    "react-dom": "^18.2.0"
  },
  "devDependencies": {
    "@types/react": "^18.2.37",
    "@types/react-dom": "^18.2.15",
    "@vitejs/plugin-react": "^4.2.1",
    "gh-pages": "^6.1.1",
    "terser": "^5.48.0",
    "typescript": "^5.2.2",
    "vite": "^5.0.8"
  }
}
